# Copy to .env and fill in. Never commit .env.
# Model provider: anthropic | openai. Empty = anthropic if an Anthropic credential is set,
# else openai if OPENAI_API_KEY is set. See README "Bring your own model".
LLM_PROVIDER=
# (a) Anthropic Messages API (any compatible endpoint)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# alternative to the key, sent as Authorization: Bearer
ANTHROPIC_AUTH_TOKEN=
MODEL=claude-sonnet-5-5
# (b) OpenAI-compatible Chat Completions with tool calling (OpenAI, OpenRouter, DeepSeek, vLLM, Ollama, a gateway)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# max_tokens (default) | max_completion_tokens (newer OpenAI models) | none
OPENAI_MAX_TOKENS_PARAM=
# claude (default) | offline = rule-based parser, no AI, no key needed
AGENT_MODE=claude

# PayPal: "mock" (default, no network) or "sandbox"
PAYPAL_MODE=mock
# mock only: 1 = orders wait for a (local, simulated) PayPal buyer approval like the real Sandbox
PAYPAL_MOCK_APPROVAL=0
# sandbox auth: "oauth" (client id + secret below) or "proxy" (credentials injected by an egress proxy)
PAYPAL_AUTH=oauth
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# where PayPal sends the buyer back after approve/cancel
PUBLIC_BASE_URL=http://localhost:8000
# minutes an unapproved PayPal order keeps its budget reservation
PAYPAL_APPROVAL_TTL_MIN=180

# token required by POST /approvals/{id}/approve|reject and POST /orders/{id}/cancel.
# Empty = those endpoints answer 503 (fail closed), unless DEMO_MODE=1 (open local demo).
APPROVER_TOKEN=
# token required by PUT /policy (Policy & spend tab). Empty = falls back to APPROVER_TOKEN.
POLICY_OWNER_TOKEN=
# max POST /tools/{name} calls per client IP per window (the MCP server's remote mode uses them)
TOOLS_RATE_LIMIT=120/60

# Optional paths
POLICY_PATH=policy.yaml
CATALOG_PATH=data/catalog.json
DB_PATH=guardrail.db

# ---- Nexconn chat approval channel (optional; Nexconn Build Challenge add-on) ----
# off (default) | mock = offline in-memory room, no account | live = Nexconn Chat SDK + Platform Chat API
NEXCONN_MODE=off
# live only: from a free Nexconn Console app (Key Management). The App Secret stays on this server.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# data center of your Nexconn app: SG (default) | NA | SA
NEXCONN_AREA=SG
# the approval room and who may decide in it (Nexconn user ids: letters and digits)
NEXCONN_GROUP_ID=grbapprovals
NEXCONN_BOT_USER_ID=grbagent
NEXCONN_APPROVER_IDS=approver1
# live, local run without a public webhook URL: 1 = the /chat page forwards the decisions it sends
NEXCONN_RELAY=0
